# ---------- REQUIRED ----------
NODE_ENV=development
PORT=5000
# MongoDB Atlas connection string (include the database name, e.g. /portfolio)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/portfolio?retryWrites=true&w=majority
# At least 32 random characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=8h
# Allowed frontend origin(s) for CORS. Comma-separate multiple (no trailing slash).
CLIENT_URL=http://localhost:5173

# ---------- ADMIN BOOTSTRAP (used by `npm run create-admin`) ----------
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-this-to-a-strong-password-12+chars

# ---------- OPTIONAL: Cloudinary (profile photo + resume uploads) ----------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------- OPTIONAL: Nodemailer SMTP (contact-form notifications) ----------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Where contact-form notifications are delivered
CONTACT_RECIPIENT=
